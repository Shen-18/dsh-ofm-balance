{
  "name": "dsh-ofm-balance",
  "version": "0.8.1",
  "description": "OFM 额度：在 DSH 侧栏显示 Our Free Model 各渠道的剩余额度。自动识别 DSH 插件与桌面应用两种数据源，按「是否已登录账号」决定显示哪些渠道，可在插件详情页按渠道开关。",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./channels": "./lib/channels.js",
    "./sources": "./lib/sources.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shen-18/dsh-ofm-balance.git"
  },
  "homepage": "https://github.com/Shen-18/dsh-ofm-balance#readme",
  "bugs": {
    "url": "https://github.com/Shen-18/dsh-ofm-balance/issues"
  },
  "scripts": {
    "test": "node --test lib/*.test.js",
    "check": "node --check lib/index.js && node --check lib/gateway.js && node --check lib/service.js && node --check lib/channels.js && node --check lib/sources.js && node --check lib/plugin-source.js && node --check lib/patch.js && node --check lib/client.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "balance",
    "usage",
    "our-free-model"
  ],
  "license": "MIT",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
